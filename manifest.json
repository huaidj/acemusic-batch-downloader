{
  "manifest_version": 3,
  "name": "ACE Music 批量下載器",
  "version": "1.8.9",
  "description": "在 acemusic.ai 一次下載整首歌的所有分軌（stems）、MIDI、MusicXML、MP3/WAV，自動改名並分類到「下載/ai音樂」。",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ACE Music 批量下載器",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "downloads",
    "storage",
    "nativeMessaging",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://acemusic.ai/*",
    "https://www.acemusic.ai/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://acemusic.ai/*",
        "https://www.acemusic.ai/*"
      ],
      "js": [
        "src/naming.js",
        "src/planner.js",
        "src/prompt-data.js",
        "src/prompts.js",
        "src/diagnostics.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}













